# Server-only. Never prefix delivery credentials with VITE_.
CONTACT_TEST_MODE=false
# Required in production: random private value >=32 characters. Shared Upstash settings below.
INQUIRY_RATE_SECRET=
RESEND_API_KEY=
# A sender on a domain verified in your Resend account.
CONTACT_FROM=
CONTACT_TO=sswayam506@gmail.com
# Optional public HTTPS calendar URL for the 20-minute discovery call.
BOOKING_URL=

# Advisor: server-only. Public lookup works without any of these settings.
ADVISOR_LLM_ENABLED=false
OPENAI_API_KEY=
# Required for paid matching: private random value of at least 32 characters.
ADVISOR_RATE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# UTC-day shared ceiling; reserves 2 cents/call; range 2..1000 cents.
ADVISOR_DAILY_BUDGET_CENTS=100
